#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x614d599f37a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x614d599f3930 .scope module, "NOT_tb" "NOT_tb" 3 1;
 .timescale 0 0;
v0x614d59a04c80_0 .var "a", 0 0;
v0x614d59a04d20_0 .net "y", 0 0, L_0x614d59a04df0;  1 drivers
S_0x614d599ba490 .scope module, "UUT" "NOT_Gate" 3 5, 4 1 0, S_0x614d599f3930;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x614d59a04df0 .functor NOT 1, v0x614d59a04c80_0, C4<0>, C4<0>, C4<0>;
v0x614d599ba620_0 .net "a", 0 0, v0x614d59a04c80_0;  1 drivers
v0x614d59a04b60_0 .net "y", 0 0, L_0x614d59a04df0;  alias, 1 drivers
    .scope S_0x614d599f3930;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "NOT.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x614d599f3930 {0 0 0};
    %vpi_call/w 3 12 "$monitor", "t=%0t | a=%b,y=%b", $time, v0x614d59a04c80_0, v0x614d59a04d20_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x614d59a04c80_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x614d59a04c80_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x614d59a04c80_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x614d59a04c80_0, 0, 1;
    %delay 10, 0;
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "NOT_tv.v";
    "NOT.v";
