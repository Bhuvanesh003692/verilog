:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c8518368830 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5c85183689c0 .scope module, "And_G_tb" "And_G_tb" 3 3;
 .timescale -9 -12;
v0x5c851837b750_0 .var "a", 0 0;
v0x5c851837b820_0 .var "b", 0 0;
v0x5c851837b8f0_0 .net "y", 0 0, L_0x5c851837b9f0;  1 drivers
S_0x5c851832f490 .scope module, "UTT" "And_G" 3 7, 4 1 0, S_0x5c85183689c0;
 .timescale 0 0;
    .port_info 0 /OUTPUT 1 "y";
    .port_info 1 /INPUT 1 "a";
    .port_info 2 /INPUT 1 "b";
L_0x5c851837b9f0 .functor AND 1, v0x5c851837b750_0, v0x5c851837b820_0, C4<1>, C4<1>;
v0x5c851832f6c0_0 .net "a", 0 0, v0x5c851837b750_0;  1 drivers
v0x5c851837b570_0 .net "b", 0 0, v0x5c851837b820_0;  1 drivers
v0x5c851837b630_0 .net "y", 0 0, L_0x5c851837b9f0;  alias, 1 drivers
    .scope S_0x5c85183689c0;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "And_G.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5c85183689c0 {0 0 0};
    %vpi_call/w 3 14 "$monitor", "t=%0t | a=%b,b=%b | y=%b", $time, v0x5c851837b750_0, v0x5c851837b820_0, v0x5c851837b8f0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c851837b750_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c851837b820_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c851837b750_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c851837b820_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c851837b750_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5c851837b820_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c851837b750_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5c851837b820_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_0;
