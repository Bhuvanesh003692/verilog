#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x564cf64e87a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x564cf64e8930 .scope module, "Buffer_tb" "Buffer_tb" 3 1;
 .timescale 0 0;
v0x564cf64f9fb0_0 .var "a", 0 0;
v0x564cf64fa050_0 .net "y", 0 0, L_0x564cf64fa120;  1 drivers
S_0x564cf64af490 .scope module, "UTT" "Buffer_gate" 3 5, 4 1 0, S_0x564cf64e8930;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x564cf64fa120 .functor BUF 1, v0x564cf64f9fb0_0, C4<0>, C4<0>, C4<0>;
v0x564cf64af620_0 .net "a", 0 0, v0x564cf64f9fb0_0;  1 drivers
v0x564cf64f9e90_0 .net "y", 0 0, L_0x564cf64fa120;  alias, 1 drivers
    .scope S_0x564cf64e8930;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "BUFFER.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x564cf64e8930 {0 0 0};
    %vpi_call/w 3 12 "$monitor", "t=%0t | a=%b |y=%b", $time, v0x564cf64f9fb0_0, v0x564cf64fa050_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564cf64f9fb0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564cf64f9fb0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564cf64f9fb0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564cf64f9fb0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "BUFFER_tb.v";
    "BUFFER.v";
