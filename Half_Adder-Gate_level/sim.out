S_0x564752a21d60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x564752a21ef0 .scope module, "Half_Adder_tb" "Half_Adder_tb" 3 1;
 .timescale 0 0;
v0x564752a35770_0 .var "a", 0 0;
v0x564752a35830_0 .var "b", 0 0;
