v0x564752a35a00_0 .net "s", 0 0, L_0x564752a35ad0;  1 drivers
S_0x5647529e8490 .scope module, "UTT" "Half_Adder" 3 6, 4 1 0, S_0x564752a21ef0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "c";
    .port_info 3 /OUTPUT 1 "s";
L_0x564752a35ad0 .functor XOR 1, v0x564752a35770_0, v0x564752a35830_0, C4<0>, C4<0>;
L_0x564752a35c30 .functor AND 1, v0x564752a35770_0, v0x564752a35830_0, C4<1>, C4<1>;
v0x5647529e86e0_0 .net "a", 0 0, v0x564752a35770_0;  1 drivers
v0x564752a35470_0 .net "b", 0 0, v0x564752a35830_0;  1 drivers
v0x564752a35530_0 .net "c", 0 0, L_0x564752a35c30;  alias, 1 drivers
v0x564752a35600_0 .net "s", 0 0, L_0x564752a35ad0;  alias, 1 drivers
    .scope S_0x564752a21ef0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "halfadder.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x564752a21ef0 {0 0 0};
    %vpi_call/w 3 13 "$monitor", "t=%0t | a=%b,b=%b | s=%b,c=%b", $time, v0x564752a35770_0, v0x564752a35830_0, v0x564752a35a00_0, v0x564752a35900_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564752a35770_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564752a35830_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564752a35770_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564752a35830_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564752a35770_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x564752a35830_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564752a35770_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x564752a35830_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 20 "$finish" {0 0 0};
