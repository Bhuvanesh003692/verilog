#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a63d90ed830 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a63d90ed9c0 .scope module, "XNOR_tb" "XNOR_tb" 3 1;
 .timescale 0 0;
v0x5a63d91005f0_0 .var "a", 0 0;
v0x5a63d91006c0_0 .var "b", 0 0;
v0x5a63d9100790_0 .net "y", 0 0, L_0x5a63d9100890;  1 drivers
S_0x5a63d90b4490 .scope module, "UUT" "XNOR_gate" 3 6, 4 1 0, S_0x5a63d90ed9c0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5a63d9100890 .functor XNOR 1, v0x5a63d91005f0_0, v0x5a63d91006c0_0, C4<0>, C4<0>;
v0x5a63d90b46c0_0 .net "a", 0 0, v0x5a63d91005f0_0;  1 drivers
v0x5a63d9100410_0 .net "b", 0 0, v0x5a63d91006c0_0;  1 drivers
v0x5a63d91004d0_0 .net "y", 0 0, L_0x5a63d9100890;  alias, 1 drivers
    .scope S_0x5a63d90ed9c0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "xnor.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a63d90ed9c0 {0 0 0};
    %vpi_call/w 3 13 "$monitor", "t=%0t | a=%b,b=%b | y=%b", $time, v0x5a63d91005f0_0, v0x5a63d91006c0_0, v0x5a63d9100790_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63d91005f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63d91006c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63d91005f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63d91006c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63d91005f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a63d91006c0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63d91005f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a63d91006c0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "XNOR_tb.v";
    "XNOR.V";
