#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56cf23f84830 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56cf23f849c0 .scope module, "XOR_tb" "XOR_tb" 3 1;
 .timescale 0 0;
v0x56cf23f97610_0 .var "a", 0 0;
v0x56cf23f976e0_0 .var "b", 0 0;
v0x56cf23f977b0_0 .net "y", 0 0, L_0x56cf23f978b0;  1 drivers
S_0x56cf23f4b490 .scope module, "UUT" "XOR" 3 6, 4 1 0, S_0x56cf23f849c0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x56cf23f978b0 .functor XOR 1, v0x56cf23f97610_0, v0x56cf23f976e0_0, C4<0>, C4<0>;
v0x56cf23f4b6c0_0 .net "a", 0 0, v0x56cf23f97610_0;  1 drivers
v0x56cf23f97430_0 .net "b", 0 0, v0x56cf23f976e0_0;  1 drivers
v0x56cf23f974f0_0 .net "y", 0 0, L_0x56cf23f978b0;  alias, 1 drivers
    .scope S_0x56cf23f849c0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "XOR.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56cf23f849c0 {0 0 0};
    %vpi_call/w 3 13 "$monitor", "t=%0t | a=%b, b=%b | y=%b", $time, v0x56cf23f97610_0, v0x56cf23f976e0_0, v0x56cf23f977b0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56cf23f97610_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56cf23f976e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56cf23f97610_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56cf23f976e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56cf23f97610_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x56cf23f976e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56cf23f97610_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x56cf23f976e0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 20 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "XOR_tb.v";
    "XOR.v";
